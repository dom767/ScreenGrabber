# Copy to .deploy-secrets.env (gitignored). Used by DeployScreengrabber.ps1.
#
# AWS credentials: use the normal AWS CLI profile / env (aws configure),
# or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION here.
# AWS_REGION=eu-west-2
#
# Optional overrides (generated if unset):
# TICKET_HMAC_SECRET=
# ADMIN_TOKEN=
#
# Cloudflare Turnstile (bot check only - not hosting):
# TURNSTILE_SECRET=
#
# DEV_BYPASS_TURNSTILE=1
#
# One-time Cloudflare teardown (then revoke the token):
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=dc9bae83e7d1233d0d8cc674dfd30197
